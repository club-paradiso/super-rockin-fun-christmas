# ─────────────────────────────────────────────────────────────
# FOLLOW THE LIGHTS — environment template
# Copy to .env.local and fill in. Phase 1 runs with NONE of these set.
# ─────────────────────────────────────────────────────────────

# Camera source for the kiosk: "browser" (real webcam) or "mock" (generated frames).
# The kiosk also accepts ?camera=mock in the URL, which wins over this value.
NEXT_PUBLIC_CAMERA_MODE=browser

# Public origin used to build QR links (e.g. https://lights.example.org).
# If unset, the kiosk uses window.location.origin.
NEXT_PUBLIC_PUBLIC_BASE_URL=

# Seconds of inactivity before the kiosk returns to Welcome.
NEXT_PUBLIC_KIOSK_IDLE_RESET_SECONDS=90

# Phase 2 — Supabase (not used yet)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# Phase 2 — how long a /p/[token] download link stays valid, and how long photos are kept.
PHOTO_LINK_TTL_HOURS=72
PHOTO_RETENTION_DAYS=30

# Phase 1 local photo store directory (gitignored). Holds guest photos — treat as private.
FTL_DATA_DIR=.data

