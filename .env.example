# ─────────────────────────────────────────────────────────────────────────────
# FOLLOW THE LIGHTS — environment template
# Copy to .env.local for development. In Vercel, set these in Project Settings.
# Anything without NEXT_PUBLIC_ stays on the server and never reaches a browser.
# ─────────────────────────────────────────────────────────────────────────────

# ── Kiosk (browser) ──────────────────────────────────────────────────────────
# "browser" (real webcam) or "mock" (generated frames). ?camera=mock in the URL wins.
NEXT_PUBLIC_CAMERA_MODE=browser
# Seconds of inactivity before the kiosk returns to Welcome.
NEXT_PUBLIC_KIOSK_IDLE_RESET_SECONDS=90

# ── Role ─────────────────────────────────────────────────────────────────────
# "cloud" (default): Vercel + Supabase, staff log in with email codes.
# "hub": the on-site laptop on the event LAN (docs/ARCHITECTURE.md part 1). Requires
# PHOTO_STORE=local; staff log in with name + PIN; plain http on the LAN is allowed.
FTL_ROLE=cloud
# Hub only: how long a staff PIN login lasts (hours).
STAFF_SESSION_HOURS=14
# Hub only: retention (D47, D58). The hub deletes on its own every 10 minutes while it runs.
# Photos never on the wall (no consent, rejected, still waiting for review): hours after capture.
HUB_UNPOSTED_HOURS=24
# Wall photos (approved or hidden): EVENT_END_AT + HUB_WALL_GRACE_HOURS. Include the offset.
# Empty = no event end yet: wall photos then follow PHOTO_RETENTION_DAYS like everything else.
EVENT_END_AT=
HUB_WALL_GRACE_HOURS=24
# Hub only: USB backup (lib/ops/backup.ts). The folder must already exist (the stick itself, e.g.
# E:\ or /Volumes/FTL-BACKUP): if it is missing the backup fails instead of writing to the laptop.
HUB_BACKUP_DIR=
HUB_BACKUP_MINUTES=10
# Hub only: the overview warns when the laptop or the stick has less free space than this.
HUB_DISK_WARN_MB=2048

# ── Media wall (hub) ─────────────────────────────────────────────────────────
# The LED's input resolution, e.g. 3840x1080. The clothesline scene is drawn at this size and
# scaled to the screen; the number of photos follows its shape. Empty = the screen's own size.
# To try a size at the LED without restarting: open /wall?canvas=3840x1080 instead.
WALL_CANVAS=
# Low-spec mode for a weak wall PC: no twinkling or swinging, at most 4 photos. (/wall?lite=1)
WALL_LITE=

# ── Hub → cloud QR copy (docs/ARCHITECTURE.md 1.5, D43, D57) ─────────────────
# Hub: where guest QR links come from. Empty = no cloud (QR links point at the hub itself, which
# phones on cellular data cannot open). Origin only, https.
CLOUD_BASE_URL=
# Both sides, same value: the only key to the cloud's /api/hub/*. At least 32 characters,
# different from every other secret: openssl rand -base64 48
HUB_SYNC_SECRET=
# Hub: how long a guest waits at the QR screen for the cloud before "QR 준비 중" (ms).
CLOUD_SYNC_TIMEOUT_MS=8000

# ── Public origin for guest QR codes (server-only) ───────────────────────────
# Required in production: https, publicly reachable (no localhost / 127.x / 192.168.x / 10.x).
# Development falls back to the request origin when empty.
PUBLIC_BASE_URL=

# ── Storage ──────────────────────────────────────────────────────────────────
# "supabase" (deployment) or "local" (files in FTL_DATA_DIR; dev / single self-hosted PC).
# Defaults to supabase when SUPABASE_URL is set.
PHOTO_STORE=local
FTL_DATA_DIR=.data
SUPABASE_URL=
# Server-only. Bypasses RLS — never expose it, never prefix it with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_PHOTO_BUCKET=photos
# Server-only: staff login (/admin) uses Supabase Auth email codes through the Next.js server.
# Never prefix with NEXT_PUBLIC_ — the browser never talks to Supabase. Even if leaked, RLS
# denies it every table, and a Supabase user is not staff unless allowlisted.
SUPABASE_ANON_KEY=

# ── Guest links and retention ────────────────────────────────────────────────
# How long a /p/[token] link works.
PHOTO_LINK_TTL_HOURS=72
# When the image object is deleted (must be ≥ the link TTL).
PHOTO_RETENTION_DAYS=30

# ── Kiosk device authentication (server-only) ────────────────────────────────
# Signs kiosk session cookies. ≥ 32 chars: openssl rand -base64 48
KIOSK_SESSION_SECRET=
# LEGACY (Phase 2) shared enrollment secret. Leave EMPTY in production: staff create one-time
# enrollment codes in /admin → 키오스크 instead. If set: ≥ 20 chars, different from the session
# secret; it also enables the legacy operator API.
KIOSK_ENROLL_SECRET=
# Kiosk session lifetime (sliding; renewed automatically while in use).
KIOSK_SESSION_DAYS=90
# Development only: skip enrollment entirely. Refused when NODE_ENV=production.
# KIOSK_AUTH_DISABLED=1

# ── Retention cron (server-only) ─────────────────────────────────────────────
# Vercel Cron sends "Authorization: Bearer $CRON_SECRET". ≥ 32 chars. Required in production.
CRON_SECRET=

# ── Staff (Phase 3) ──────────────────────────────────────────────────────────
# First staff member (once): npm run staff:add -- you@example.org "이름"
# (uses SUPABASE_URL + SUPABASE_SERVICE_ROLE_KEY). Later staff are added in /admin → 설정.
# Optional build label shown in kiosk heartbeats (Vercel sets VERCEL_GIT_COMMIT_SHA itself).
FTL_APP_BUILD=
