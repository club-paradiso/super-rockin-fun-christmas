{
  "name": "follow-the-lights",
  "version": "0.1.0",
  "private": true,
  "description": "STUDIO SHALOM — four-cut photo booth and participatory media wall for Christmas Village 2026",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "npm run build:kiosk-legacy && npm run build:retouch-lab && npm run build:looks-sheet && npm run build:camera-lab && next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm run test",
    "test:supabase": "bash scripts/test-supabase.sh",
    "staff:add": "node scripts/staff-add.mjs",
    "looks:build": "node scripts/looks-build.mjs",
    "looks:preview": "node scripts/looks-preview.mjs",
    "looks:measure": "node scripts/looks-measure.mjs",
    "build:kiosk-legacy": "vite build --config legacy-kiosk/vite.config.mts",
    "build:retouch-lab": "vite build --config retouch-lab/vite.config.mts",
    "build:looks-sheet": "vite build --config looks-sheet/vite.config.mts",
    "build:camera-lab": "vite build --config camera-lab/vite.config.mts",
    "predev": "npm run build:kiosk-legacy && npm run build:retouch-lab && npm run build:looks-sheet && npm run build:camera-lab"
  },
  "dependencies": {
    "@fontsource-variable/noto-sans-kr": "^5.3.1",
    "@fontsource-variable/noto-sans-sc": "^5.3.1",
    "@fontsource/caveat": "^5.3.0",
    "@fontsource/cormorant-garamond": "^5.3.0",
    "@fontsource/covered-by-your-grace": "^5.3.0",
    "@fontsource/give-you-glory": "^5.3.0",
    "@fontsource/gloria-hallelujah": "^5.3.0",
    "@fontsource/nanum-myeongjo": "^5.3.0",
    "@fontsource/nothing-you-could-do": "^5.3.0",
    "@fontsource/permanent-marker": "^5.3.0",
    "@fontsource/reenie-beanie": "^5.3.0",
    "@fontsource/rock-salt": "^5.3.0",
    "@fontsource/shadows-into-light": "^5.3.0",
    "@fontsource/square-peg": "^5.3.0",
    "@fontsource/vt323": "^5.3.0",
    "@mediapipe/tasks-vision": "0.10.21",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.117.2",
    "next": "^16.4.5",
    "qrcode": "^1.5.4",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "server-only": "^0.0.1",
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.7",
    "@fontsource/ibm-plex-mono": "^5.2.7",
    "@playwright/test": "^1.56.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^22.20.5",
    "@types/pg": "^8.23.1",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "esbuild": "0.28.2",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.4.5",
    "fake-indexeddb": "^6.2.5",
    "jsdom": "^29.1.1",
    "opentype.js": "^1.3.4",
    "pg": "^8.23.1",
    "prettier": "^3.9.9",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "vite": "8.3.3",
    "vitest": "^5.0.3"
  },
  "browserslist": [
    "chrome >= 111",
    "edge >= 111",
    "firefox >= 111",
    "safari >= 15.6",
    "ios_saf >= 15.6"
  ]
}
